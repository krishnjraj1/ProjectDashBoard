# JIRA Connection Configuration
# Copy this file to .env.local and fill in your values:
#   cp .env.local.example .env.local

# Your Atlassian instance URL (must start with https://)
# Example: https://yourteam.atlassian.net
JIRA_BASE_URL=

# The email address associated with your Atlassian account
# Example: you@company.com
JIRA_EMAIL=

# Your Atlassian API token (generate at https://id.atlassian.com/manage-profile/security/api-tokens)
# This token is used for Basic Auth and should be kept secret
JIRA_API_TOKEN=
